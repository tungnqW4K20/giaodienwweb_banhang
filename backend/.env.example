# Environment Configuration for EcoFruit Clean Fruit E-Commerce Backend

# Django Core
DEBUG=True
SECRET_KEY=ecofruit_super_secret_enterprise_django_key_2026_!@#$%^
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com

# Database (Default MySQL with auto-fallback to SQLite for zero-setup local dev)
DATABASE_URL=mysql://root:password@127.0.0.1:3306/ecofruit_db
# Or use standard parameters:
DB_ENGINE=django.db.backends.mysql
DB_NAME=ecofruit_db
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis & Message Queue (Celery)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
CORS_ALLOW_ALL_ORIGINS=True

# VNPay Sandbox Configuration
VNPAY_TMN_CODE=ECOFRUIT01
VNPAY_HASH_SECRET=SANDBOXSECRETKEY1234567890ABCDEF
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/profile.html

# AI Assistant API Keys (Gemini / Groq / OpenRouter / HuggingFace - Auto Fallback Engine included)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Security & Tokens
JWT_SECRET=ecofruit_jwt_super_signature_key_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=1440
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30
